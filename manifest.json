{
  "id": "com.lexalfa.panel",
  "name": "Lex Alfa",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 6,
  "requiredPermissions": {
    "network": {
      "domains": "none"
    },
    "clipboard": "read",
    "localFileSystem": "fullAccess"
  },
  "icons": [
    { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light", "all"] }
  ],
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "lexalfa.main",
      "label": { "default": "Lex Alfa" },
      "main": "index.html",
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light", "all"] }
      ],
      "minimumSize": { "width": 340, "height": 500 },
      "maximumSize": { "width": 900, "height": 1600 },
      "preferredDockedSize": { "width": 420, "height": 720 },
      "preferredFloatingSize": { "width": 420, "height": 720 }
    }
  ]
}
